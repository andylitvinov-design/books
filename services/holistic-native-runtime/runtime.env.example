# Copy ONLY on the authorized CLOUD VM to /etc/holistic-native-runtime.env (chmod 600).
# Generate a cryptographic random token on the VM; never commit or paste its value.
HH_NATIVE_RUNTIME_TOKEN=
HH_NATIVE_CHAT_MODEL=qwen3.5:0.8b
HH_NATIVE_EMBED_MODEL=qwen3-embedding:0.6b
HH_NATIVE_EMBED_BACKEND=ollama
HH_NATIVE_GATEWAY_PORT=8787
HH_NATIVE_MAX_TOKENS=48
# To use optional E5 instead of qwen3-embedding:0.6b:
# HH_NATIVE_EMBED_BACKEND=e5
# HH_E5_MODEL_DIR=/srv/holistic-native-models/multilingual-e5-small
