{
  "inputs": [],
  "servers": {
    "holistic-playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--headless",
        "--block-service-workers"
      ]
    },
    "holistic-chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--isolated",
        "--headless",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--file-navigations=false"
      ]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
