{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex,nofollow,noarchive"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=20, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ci-runner-trends",
      "destination": "https://holistic-house-pr-monitor.vercel.app/api/ci-runner-trends"
    },
    {
      "source": "/api/pr-stage-timeline",
      "destination": "https://holistic-house-pr-monitor.vercel.app/api/pr-stage-timeline"
    },
    {
      "source": "/api/pr-stage-overview",
      "destination": "https://holistic-house-pr-monitor.vercel.app/api/pr-stage-overview"
    },
    {
      "source": "/api/ci-insights",
      "destination": "https://holistic-house-pr-monitor.vercel.app/api/ci-insights"
    },
    {
      "source": "/api/control-tower-stats",
      "destination": "https://holistic-house-pr-monitor.vercel.app/api/control-tower-stats"
    },
    {
      "source": "/api/pr-three-kpis",
      "destination": "https://holistic-house-pr-monitor.vercel.app/api/pr-three-kpis"
    }
  ]
}
