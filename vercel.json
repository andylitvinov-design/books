{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/internal/housekeeping",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/internal/revenue-ideas-telegram",
      "schedule": "0 13,14 * * *"
    },
    {
      "path": "/api/internal/practice-telegram-digest",
      "schedule": "0 13,14,19,20 * * *"
    },
    {
      "path": "/api/internal/council-archive-telegram",
      "schedule": "0 16,17 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "codex/public-book-library": true
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs"
}
