{
  "name": "books-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:unit": "node --test tests/**/*.test.mjs",
    "test:app": "node --test tests/app-assessments.test.mjs tests/app-migration-contract.test.mjs tests/app-http-security.test.mjs tests/app-timestamps.test.mjs",
    "test:app:db": "node --conditions=react-server --test --test-concurrency=1 tests/app-database.integration.mjs",
    "validate:remedy-inventory": "node scripts/validate-remedy-source-inventory.mjs",
    "generate:remedy-content": "node scripts/generate-phase-l-remedy-content.mjs",
    "audit:remedy-completeness": "node scripts/audit-remedy-source-completeness.mjs",
    "validate:remedy-content": "node scripts/validate-remedy-content.mjs",
    "build:remedy-images": "node scripts/build-remedy-image-layer.mjs",
    "validate:remedy-images": "node scripts/validate-remedy-images.mjs",
    "verify:homeopathy-routes": "node scripts/verify-homeopathy-routes.mjs",
    "pwa:check": "node --test tests/psialchemy-pwa.test.mjs",
    "native:check": "node --test tests/native-*.test.mjs",
    "native:sync": "cap sync",
    "native:ios:simulator": "cap sync ios && xcodebuild -workspace ios/App/App.xcworkspace -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "native:android:debug": "cap sync android && cd android && ./gradlew assembleDebug --stacktrace"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.114.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.5.21",
    "pg": "8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "$postcss",
    "sharp": "0.35.0"
  }
}
