  "attunements": [
    {
      "id": "greek-zeus-antalya-2021",
      "tradition": "greek",
      "channel": "zeus",
      "title": {
        "ru": "Зевс · Музей Анталии",
        "en": "Zeus · Antalya Museum",
        "es": "Zeus · Museo de Antalya"
      },
      "place": {
        "city": {
          "ru": "Анталия",
          "en": "Antalya",
          "es": "Antalya"
        },
        "site": {
          "ru": "Археологический музей Анталии",
          "en": "Antalya Archaeological Museum",
          "es": "Museo Arqueológico de Antalya"
        },
        "type": "museum",
        "country": {
          "ru": "Турция",
          "en": "Türkiye",
          "es": "Turquía"
        }
      },
      "originalLanguage": "ru",
      "text": "Орел - не дрогнет при полете.\nОн знает скорости красу.\nМгновенно схватит цель в полете,\nПоднявшись снова в высоту. \n\nТех Сил широкая могучесть\nЧто держит времени покой\nТворит Волну - Миров текучесть,\nВскрывая бездны приговор. \n\nТем силам нет границ, пределов.\nСияет в звездах их судьба.\nБлагое дело с ними смело\nВедет к победе сквозь года. \n\nПолет идей рождая смело\nНесут масштабности поток\nТворят грядущего пределы\nВзрастив величия росток.",
      "photos": [
        {
          "src": "/images/temple-channels/zeus-antalya.jpg",
          "sourceFile": "photo_222@16-11-2021_15-11-39.jpg",
          "sourceMessageId": 437
        }
      ],
      "source": {
        "kind": "telegram_export",
        "archiveId": "1xtpeR3ntz1QJOSSyFrDfwUHqShIWGUDL",
        "messageId": 437,
        "publishedAt": "2021-11-16"
      },
      "editorialNote": null
    },
    {
      "id": "greek-zeus-kaunos-2021",
      "tradition": "greek",
      "channel": "zeus",
      "title": {
        "ru": "Зевс · Каунос",
        "en": "Zeus · Kaunos",
        "es": "Zeus · Cauno"
      },
      "place": {
        "city": {
          "ru": "Каунос",
          "en": "Kaunos",
          "es": "Cauno"
        },
        "site": {
          "ru": "Храмовый комплекс Кауноса (Зевс/Аполлон в источнике)",
          "en": "Kaunos temple site (Zeus/Apollo per source)",
          "es": "Santuario de Cauno (Zeus/Apolo según fuente)"
        },
        "type": "archaeological_site",
        "country": {
          "ru": "Турция",
          "en": "Türkiye",
          "es": "Turquía"
        }
      },
      "originalLanguage": "ru",
      "text": "Тебя окружает бесчетность миров\nСиянье светил среди белого дня\nТы здесь во плоти, светоч огненных звезд\nТы вестник клокочущей силы огня. \n\nТы голос Богов, центр жизни Земли.\nДержатель всех сил и Воятель миров.\nТы центр мирозданья, всех сил властелен.\nТворишь чудеса, водворяя добро.",
      "photos": [
        {
          "src": "/images/temple-channels/zeus-kaunos.jpg",
          "sourceFile": "photo_274@13-12-2021_04-19-17.jpg",
          "sourceMessageId": 506
        },
        {
          "src": "/images/temple-channels/zeus-kaunos-detail.jpg",
          "sourceFile": "photo_273@13-12-2021_04-19-17.jpg",
          "sourceMessageId": 505
        }
      ],
      "source": {
        "kind": "telegram_export",
        "archiveId": "1xtpeR3ntz1QJOSSyFrDfwUHqShIWGUDL",
        "messageId": 509,
        "publishedAt": "2021-12-13"
      },
      "editorialNote": {
        "ru": "В авторском тексте указана неоднозначная атрибуция комплекса: храм Зевса или Аполлона.",
        "en": "The author notes an uncertain Zeus/Apollo attribution.",
        "es": "El autor indica una atribución incierta a Zeus/Apolo."
      }
    },
    {
      "id": "greek-zeus-pergamon-2021",
      "tradition": "greek",
      "channel": "zeus",
      "title": {
        "ru": "Зевс · Пергамон",
        "en": "Zeus · Pergamon",
        "es": "Zeus · Pérgamo"
      },
      "place": {
        "city": {
          "ru": "Пергамон",
          "en": "Pergamon",
          "es": "Pérgamo"
        },
        "site": {
          "ru": "«Престол Зевса» (по авторскому описанию)",
          "en": "Seat of Zeus (as described by the author)",
          "es": "Trono de Zeus (según el autor)"
        },
        "type": "archaeological_site",
        "country": {
          "ru": "Турция",
          "en": "Türkiye",
          "es": "Turquía"
        }
      },
      "originalLanguage": "ru",
      "text": "Умеренность, решительность.\nВерховные права.\nСудьбы хранишь величие.\nСтираяя рябь до тла. \n\nВершишь миров развитие\nВнося порядки там\nБлюстишь красот наличие\nВоздвигая жизни Храм.",
      "photos": [
        {
          "src": "/images/temple-channels/zeus-pergamon.jpg",
          "sourceFile": "photo_275@13-12-2021_04-19-17.jpg",
          "sourceMessageId": 507
        }
      ],
      "source": {
        "kind": "telegram_export",
        "archiveId": "1xtpeR3ntz1QJOSSyFrDfwUHqShIWGUDL",
        "messageId": 509,
        "publishedAt": "2021-12-13"
      },
      "editorialNote": {
        "ru": "Фото взято из соседнего сообщения того же поста; место съёмки не подтверждено.",
