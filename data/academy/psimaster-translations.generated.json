  "mysteries/egypt/high-wisdom": {
    "en": [
      {
        "type": "h1",
        "text": "High Wisdom of the Egyptian Gods"
      },
      {
        "type": "p",
        "text": "A historical PsiMaster program on Egyptian symbolic tradition. It is preserved as an educational archive without the original promises of healing or supernatural effects."
      },
      {
        "type": "h2",
        "text": "7 modules"
      },
      {
        "type": "h3",
        "text": "1. Osiris"
      },
      {
        "type": "p",
        "text": "Purification and completion of an old phase; the images of Ka, Ba, Ib and Khaibit in the language of the course."
      },
      {
        "type": "h3",
        "text": "2. Maat"
      },
      {
        "type": "p",
        "text": "Order, balance and inner orientation."
      },
      {
        "type": "h3",
        "text": "3. Horus"
      },
      {
        "type": "p",
        "text": "Action, creativity and launching a project."
      },
      {
        "type": "h3",
        "text": "4. Isis"
      },
      {
        "type": "p",
        "text": "Strategy and unconventional solutions."
      },
      {
        "type": "h3",
        "text": "5. Hathor and Tefnut"
      },
      {
        "type": "p",
        "text": "Support, care and restoration as symbolic themes."
      },
      {
        "type": "h3",
        "text": "6. Thoth"
      },
      {
        "type": "p",
        "text": "Knowledge, writing, symbolic formulas and artifacts."
      },
      {
        "type": "h3",
        "text": "7. Amun-Ra and Min-Ra"
      },
      {
        "type": "p",
        "text": "Scale, expansion and moving beyond familiar limits."
      }
    ]
  },
